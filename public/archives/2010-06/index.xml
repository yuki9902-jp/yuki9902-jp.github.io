    <item>
      <title>できなくなっていること</title>
      <link>https://yuki9902-jp.github.io/posts/2010-06-21_%E3%81%A7%E3%81%8D%E3%81%AA%E3%81%8F%E3%81%AA%E3%81%A3%E3%81%A6%E3%81%84%E3%82%8B%E3%81%93%E3%81%A8/</link>
